# AI Visibility Platform - Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# SUPABASE (Required)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
DATABASE_URL=postgres://user:password@host:5432/database

# =============================================================================
# AI PROVIDERS (At least one required)
# =============================================================================

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=org-...           # Optional
OPENAI_PROJECT_ID=proj-...      # Optional

# Google Gemini - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=...

# Anthropic - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# xAI (Grok) - https://console.x.ai/
XAI_API_KEY=xai-...
XAI_SEARCH_MODE=auto            # Options: auto, on, off
XAI_MAX_SEARCH_RESULTS=10

# OpenRouter (for DeepSeek query generation)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=deepseek/deepseek-v3.2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=            # Optional, for analytics
OPENROUTER_APP_NAME=            # Optional, for analytics

# =============================================================================
# MODEL CONFIGURATION (Optional)
# =============================================================================

# Gemini model overrides
GEMINI_ANALYSIS_MODEL=models/gemini-3-pro-preview
GEMINI_ANALYSIS_MODEL_FLASH=models/gemini-3-flash-preview

# DeepSeek model for query generation
DEEPSEEK_MODEL=deepseek/deepseek-v3.2

# =============================================================================
# CONCURRENCY LIMITS (Optional)
# =============================================================================
# Number of parallel requests per provider (default: 3)
OPENAI_CONCURRENCY=3
GEMINI_CONCURRENCY=3
ANTHROPIC_CONCURRENCY=3
XAI_CONCURRENCY=3

# =============================================================================
# SCHEDULED JOBS (Optional)
# =============================================================================
CRON_SECRET=your-secret-for-cron-endpoints

# =============================================================================
# TENANT CONFIGURATION OVERRIDES (Optional)
# =============================================================================
# These override values from config/tenant.json
BRAND_NAME=
BRAND_ALIASES=                  # Comma-separated list
BRAND_DOMAIN=
BRAND_HIGHLIGHT_COLOR=

# =============================================================================
# ADMIN PANEL (Optional)
# =============================================================================
# Enable admin panel in view toggle (Matrix | Kanban | Admin)
# Set to "true" to show Admin link and enable /admin/matrix route
NEXT_PUBLIC_ADMIN_ENABLED=false

# =============================================================================
# DEVELOPMENT (Optional)
# =============================================================================
NODE_ENV=development
