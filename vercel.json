{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/benchmark/batch-submit",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/benchmark/scheduled/explore",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/benchmark/scheduled/consider",
      "schedule": "10 10 * * *"
    },
    {
      "path": "/api/benchmark/scheduled/compare",
      "schedule": "20 10 * * *"
    },
    {
      "path": "/api/benchmark/scheduled/decide",
      "schedule": "30 10 * * *"
    }
  ]
}
