# Preview Environment Template
# Use STAGING Supabase values only.
# Never point preview to production Supabase.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
DATABASE_URL=postgres://postgres:password@db.your-staging-ref.supabase.co:5432/postgres

# App controls
NEXT_PUBLIC_ADMIN_ENABLED=true
CRON_SECRET=your-preview-cron-secret

# Provider keys (set those needed by enabled providers)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
XAI_API_KEY=xai-...
OPENROUTER_API_KEY=sk-or-...
